{
  "name": "dsh-local-bridge",
  "version": "0.1.0-alpha.6",
  "private": false,
  "description": "Durable same-machine messaging between DeepSeek Harness (DSH) conversations: local hub, DSH host plugin, CLI.",
  "type": "module",
  "main": "./adapters/dsh/plugin.mjs",
  "bin": {
    "dsh-local-bridge": "./bin/lab-bridge.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:codex-receiver": "node --test codex-receiver/tests/*.test.mjs",
    "hub": "node hub/main.mjs",
    "cli": "node bin/lab-bridge.mjs",
    "check": "node bin/lab-bridge.mjs check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suancaiyu10108899/dsh-local-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/suancaiyu10108899/dsh-local-bridge/issues"
  },
  "homepage": "https://github.com/suancaiyu10108899/dsh-local-bridge#readme",
  "files": [
    "adapters",
    "bin",
    "cordis.patch.yml",
    "docs",
    "hub",
    "LICENSE",
    "README.md",
    "src"
  ]
}
